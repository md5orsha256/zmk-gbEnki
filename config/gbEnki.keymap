#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define F   1
#define NAV 2
#define MED 3
#define NUM 4
#define SYM 5
#define ADJ 6

&lt { quick_tap_ms = <220>; };

&mt {
    quick_tap_ms = <200>;
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

/ {
    macros {
        numdot: numdot {
            label = "ZM_numdot";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp KP_N4 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };
        grtsgn: grtsgn {
            label = "ZM_grtsgn";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp KP_N6 &kp KP_N2>
                , <&macro_release &kp LALT>
                ;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------
            //| LGUI/] |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | RGUI/[ |
            //| CTRL/` |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | CTRL/' |
            //| LALT/\ |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | RALT/- |
            //                             | MED | NAV | F |   | SYM | NUM | ADJ |
            bindings = <
&mt LG(LC(Q)) GRAVE  &kp Q        &kp W           &kp E        &kp R             &kp T    &kp Y        &kp U              &kp I                &kp O            &kp P               &mt RIGHT_BRACKET LBKT
&mt LCTRL CAPSLOCK   &mt LWIN A   &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G    &kp H        &mt RIGHT_SHIFT J  &mt RIGHT_CONTROL K  &mt RIGHT_ALT L  &mt RWIN SEMICOLON  &mt RCTRL SQT
&mt LALT MINUS       &lt ADJ Z    &kp X           &kp C        &kp V             &kp B    &kp N        &kp M              &kp COMMA            &kp DOT          &lt ADJ SLASH       &mt RALT BACKSLASH
                                                  &lt MED ESC  &lt NAV SPACE     &lt F TAB    &lt SYM ENTER  &lt NUM BACKSPACE  &lt ADJ DELETE
            >;
        };

        f {
            bindings = <
&none  &none     &none         &none      &none           &none    &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12  &mt RWIN F1
&none  &kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none    &kp SCROLLLOCK   &kp F4  &kp F5  &kp F6  &kp F11  &mt RALT F2
&none  &none     &none         &none      &none           &none    &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10  &mt RALT F3
                               &trans     &trans          &trans   &trans           &trans  &trans
            >;
        };

        navigation {
            bindings = <
&none  &none     &none         &none      &none           &none    &kp RS(DEL)  &none     &none          &none        &none    &none
&none  &kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none    &kp LEFT     &kp DOWN  &kp UP_ARROW   &kp RIGHT    &none    &none
&none  &none     &none         &none      &none           &none    &kp INS      &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &none
                               &trans     &trans          &trans   &trans       &trans    &trans
            >;
        };

        multimedia {
            bindings = <
&none  &none           &none         &none       &none            &none        &none           &none              &none       &none            &none       &none
&none  &kp K_PREVIOUS  &kp K_VOL_DN  &kp K_MUTE  &kp K_VOLUME_UP  &kp K_NEXT   &kp K_PREVIOUS  &kp K_VOLUME_DOWN  &kp K_MUTE  &kp K_VOLUME_UP  &kp K_NEXT  &none
&none  &none           &none         &none       &none            &none        &none           &none              &none       &none            &none       &none
                                     &none       &kp K_PLAY_PAUSE &none        &none           &kp K_PLAY_PAUSE   &trans
            >;
        };

        digits {
            bindings = <
&none  &kp GRAVE  &kp N7  &kp N8   &kp N9  &kp BSLH     &none   &none      &none      &none     &none     &none
&none  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &none   &kp LSHFT  &kp LCTRL  &kp LALT  &kp LWIN  &none
&none  &kp LBKT   &kp N1  &kp N2   &kp N3  &kp RBKT     &none   &none      &none      &none     &none     &none
                          &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };

        symbols {
            bindings = <
&none  &kp TILDE       &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp PIPE           &none   &none      &none      &none     &none     &none
&none  &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS           &none   &kp LSHFT  &kp LCTRL  &kp LALT  &kp LWIN  &none
&none  &kp LEFT_BRACE  &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp RIGHT_BRACE    &none   &none      &none      &none     &none     &none
                                        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans  &trans     &trans
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            //| BLDR |     |     |     |     |     |   |     |     |     |     |     | BLDR |
            //| BTCLR| BT0 | BT1 | BT2 | BT3 | BT4 |   | BT4 | BT3 | BT2 | BT1 | BT0 | BTCLR|
            //|pwrOFF|pwrON|     |     |     |     |   |     |     |     |     |pwrON |pwrOFF|
            //                   |     |     |     |   |     |     |     |
            bindings = <
&bootloader        &none             &none         &none         &none         &none            &none         &none         &none         &none         &none             &bootloader
&bt BT_CLR         &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0      &bt BT_CLR
&ext_power EP_OFF  &ext_power EP_ON  &none         &none         &none         &none            &none         &none         &none         &none         &ext_power EP_ON  &ext_power EP_OFF
                                                   &trans        &none         &trans           &trans        &trans        &trans
            >;
        };
    };
};
